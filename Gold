# ─── CACHE LAYER ──────────────────────────────────────────────────────────────
# Each indicator caches its last successful download to avoid re-fetching
# unchanged data. Cache key = indicator_name + series_id.
# Cache stores: {last_fetched, row_count, file_path}

def get_cache_path(indicator_name: str) -> str:
    return os.path.join(CACHE_DIR, f"{indicator_name}_meta.json")

def load_indicator_cache(indicator_name: str) -> dict:
    path = get_cache_path(indicator_name)
    if os.path.exists(path):
        with open(path, "r") as f:
            return json.load(f)
    return {}

def save_indicator_cache(indicator_name: str, meta: dict):
    path = get_cache_path(indicator_name)
    with open(path, "w") as f:
        json.dump(meta, f, indent=2)


