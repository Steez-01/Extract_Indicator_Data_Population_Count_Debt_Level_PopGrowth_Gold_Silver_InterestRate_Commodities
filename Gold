# CORE EXTRACTION ENGINE
# ═══════════════════════════════════════════════════════════════════════════════

def extract_indicator(job: dict) -> pd.DataFrame:
    """Extract data for one indicator job using its prioritised source chain.

    Tries each source in priority order. For each source type:
      fred     → fetch_fred_multiple()
      yfinance → fetch_yfinance_series()

    Merges all successful sources into a single DataFrame (outer join on date).
    Returns the combined DataFrame, or empty if all sources fail.
    """
    name = job["name"]
    desc = job["description"]
    log.info(f"\n{'='*60}")
    log.info(f"EXTRACTING: {name}")
    log.info(f"  {desc}")
    log.info(f"  Period: {START_DATE} → {END_DATE}")
    log.info(f"{'='*60}")

    all_frames = []
    source_notes = []

    # Sort sources by priority
    sources = sorted(job["sources"], key=lambda s: s.get("priority", 99))

    for src in sources:
        src_type  = src["type"]
        series    = src["series"]
        note      = src.get("note", "")

        log.info(f"\n  Source: {src_type} (priority {src.get('priority', '?')})")
        if note:
            log.info(f"    {note}")

        df = pd.DataFrame()

        if src_type == "fred":
            if not FRED_API_KEY:
                log.warning(f"    Skipping FRED source — no API key set. "
                            f"Set FRED_API_KEY env var or paste into script.")
                continue
            df = fetch_fred_multiple(series, START_DATE, END_DATE)

        elif src_type == "yfinance":
            df = fetch_yfinance_series(series, START_DATE, END_DATE)

        else:
            log.warning(f"    Unknown source type: {src_type}")
            continue

        if not df.empty:
            all_frames.append(df)
            source_notes.append(f"{src_type}: {list(series.keys())}")
            log.info(f"    ✓ Got {df.shape[1]} series × {len(df)} days")
        else:
            log.warning(f"    ✗ No data from {src_type}")

    if not all_frames:
        log.error(f"  No data obtained for {name} from any source. Skipping.")
        return pd.DataFrame()

    # Merge all source frames on date (outer join keeps all dates)
    combined = all_frames[0]
    for df in all_frames[1:]:
        # Don't duplicate columns — only add new ones
        new_cols = [c for c in df.columns if c not in combined.columns]
        if new_cols:
            combined = combined.join(df[new_cols], how="outer")

    combined = combined.sort_index()

    # Summary stats
    date_range = f"{combined.index.min().date()} → {combined.index.max().date()}"
    total_days = len(combined)
    total_series = combined.shape[1]
    non_null_pct = (combined.notna().sum().sum() /
                    (total_days * total_series) * 100) if total_days > 0 else 0

    log.info(f"\n  COMBINED: {total_series} series × {total_days} days")
    log.info(f"  Date range: {date_range}")
    log.info(f"  Data completeness: {non_null_pct:.1f}%")

    # Per-series stats
    for col in combined.columns:
        s = combined[col].dropna()
        if len(s) > 0:
            log.info(f"    {col}: {len(s)} obs, "
                     f"{s.index.min().date()} → {s.index.max().date()}, "
                     f"latest={s.iloc[-1]:.4f}" if isinstance(s.iloc[-1], float)
                     else f"    {col}: {len(s)} obs")

    return combined


def save_indicator(job: dict, df: pd.DataFrame):
    """Save indicator data in the same format as the stock extractor.

    Output layout (transposed wide format, matching stock script):
      Row index = Series name (e.g. "Gold_London_AM_Fix_USD")
      Columns   = Metadata cols + date columns (YYYY-MM-DD)

    This format lets users load the CSV and directly compare with stock CSVs.
    """
    if df.empty:
        return

    name = job["name"]
    metadata = job.get("metadata", {})

    # Transpose: series become rows, dates become columns
    df_wide = df.transpose()
    df_wide.columns = pd.to_datetime(df_wide.columns).strftime("%Y-%m-%d")

    # Prepend metadata columns
    meta_cols = pd.DataFrame(index=df_wide.index)
    meta_cols["Description"] = job["description"]
    meta_cols["Unit"]        = job.get("unit", "")
    meta_cols["Frequency"]   = job.get("frequency", "daily")
    for k, v in metadata.items():
        meta_cols[k] = v

    df_out = pd.concat([meta_cols, df_wide], axis=1)

    # Generate filename
    n_series = df.shape[1]
    n_days   = len(df)
    filename = os.path.join(OUTPUT_DIR,
                            f"{name}_{n_series}_series_{n_days}_days.csv")

    df_out.to_csv(filename, index_label="Series")

    n_meta = len(meta_cols.columns)
    log.info(f"\n  ✓ SAVED: {filename}")
    log.info(f"    {n_series} series × {n_days} days + {n_meta} metadata columns")

    # Update cache metadata
    save_indicator_cache(name, {
        "last_fetched": datetime.today().strftime("%Y-%m-%d %H:%M:%S"),
        "series_count": n_series,
        "day_count":    n_days,
        "file_path":    filename,
        "date_range":   f"{df.index.min().date()} → {df.index.max().date()}",
    })


