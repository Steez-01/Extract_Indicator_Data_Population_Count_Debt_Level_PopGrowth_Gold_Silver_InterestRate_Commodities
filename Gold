def print_summary(results: list):
    """Print a summary table of all extracted indicators."""
    log.info(f"\n{'='*70}")
    log.info(f"EXTRACTION SUMMARY")
    log.info(f"{'='*70}")
    log.info(f"{'Indicator':<25} {'Series':>8} {'Days':>8} {'Date Range':<30} {'Status'}")
    log.info(f"{'-'*25} {'-'*8} {'-'*8} {'-'*30} {'-'*10}")

    for r in results:
        status = "✓ OK" if r["success"] else "✗ FAIL"
        log.info(f"{r['name']:<25} {r['series']:>8} {r['days']:>8} "
                 f"{r['date_range']:<30} {status}")

    successes = sum(1 for r in results if r["success"])
    log.info(f"\n  Total: {successes}/{len(results)} indicators extracted successfully")


