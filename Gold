# ─── FRED ADAPTER ─────────────────────────────────────────────────────────────
# FRED provides the gold standard for US economic time series.
# Free API: up to 120 requests/minute, no daily cap.
# Series IDs: https://fred.stlouisfed.org/tags/series

def fetch_fred_series(series_id: str, start: str = START_DATE,
                      end: str = END_DATE, name: str = None) -> pd.Series:
    """Fetch a single FRED series. Returns a named pd.Series with DatetimeIndex."""
    if not FRED_AVAILABLE or not FRED_API_KEY:
        log.warning(f"   FRED unavailable for {series_id} — no API key or fredapi missing")
        return pd.Series(dtype=float)

    label = name or series_id
    try:
        fred = Fred(api_key=FRED_API_KEY)
        data = fred.get_series(series_id, observation_start=start,
                               observation_end=end)
        if data is not None and not data.empty:
            data.name = label
            data.index = pd.to_datetime(data.index)
            # Drop NaN rows (FRED uses '.' for missing)
            data = data.dropna()
            log.info(f"   FRED {series_id}: {len(data)} observations "
                     f"({data.index.min().date()} → {data.index.max().date()})")
            return data
        else:
            log.warning(f"   FRED {series_id}: empty response")
            return pd.Series(dtype=float, name=label)
    except Exception as e:
        log.warning(f"   FRED {series_id} failed: {e}")
        return pd.Series(dtype=float, name=label)


def fetch_fred_multiple(series_dict: dict, start: str = START_DATE,
                        end: str = END_DATE) -> pd.DataFrame:
    """Fetch multiple FRED series and combine into a DataFrame.

    series_dict: {display_name: FRED_series_id}
    Returns: DataFrame with DatetimeIndex, one column per series.
    """
    frames = []
    for display_name, series_id in series_dict.items():
        s = fetch_fred_series(series_id, start, end, name=display_name)
        if not s.empty:
            frames.append(s)
        time.sleep(0.2)  # gentle rate limiting

    if frames:
        df = pd.concat(frames, axis=1)
        df.index = pd.to_datetime(df.index)
        df = df.sort_index()
        return df
    return pd.DataFrame()


# ─── YAHOO FINANCE ADAPTER ───────────────────────────────────────────────────
# Used for: commodities (gold, silver, oil futures), VIX, bond ETFs
# Tickers: GC=F (gold), SI=F (silver), CL=F (WTI), BZ=F (Brent), ^VIX

def fetch_yfinance_series(tickers: dict, start: str = START_DATE,
                          end: str = END_DATE) -> pd.DataFrame:
    """Fetch multiple Yahoo Finance tickers and return Close prices.

    tickers: {display_name: yf_ticker_symbol}
    Returns: DataFrame with DatetimeIndex, one column per ticker (display_name).
    """
    ticker_list = list(tickers.values())
    name_map = {v: k for k, v in tickers.items()}  # reverse: symbol → display_name

    for attempt in range(1, RETRY_ATTEMPTS + 1):
        try:
            data = yf.download(
                ticker_list, start=start, end=end,
                auto_adjust=True, progress=False, threads=False
            )
            if data.empty:
                raise ValueError("yfinance returned empty DataFrame")

            # Handle single vs multi-ticker response
            if isinstance(data.columns, pd.MultiIndex):
                if "Close" in data.columns.get_level_values(0):
                    close = data["Close"]
                else:
                    close = data
            else:
                if len(ticker_list) == 1:
                    if "Close" in data.columns:
                        close = data[["Close"]].rename(
                            columns={"Close": ticker_list[0]})
                    else:
                        close = data.iloc[:, :1]
                        close.columns = [ticker_list[0]]
                else:
                    close = data

            # Rename columns from yf symbols to display names
            close = close.rename(columns=name_map)

            log.info(f"   yfinance: {close.shape[1]} series, "
                     f"{len(close)} observations "
                     f"({close.index.min().date()} → {close.index.max().date()})")
            return close

        except Exception as e:
            err_str = str(e)
            if "Too Many Requests" in err_str or "Rate" in err_str:
                wait = 60 * attempt
                log.warning(f"   Rate limited — waiting {wait}s (attempt {attempt})")
                time.sleep(wait)
            else:
                log.warning(f"   yfinance attempt {attempt} failed: {e}")
                if attempt < RETRY_ATTEMPTS:
                    time.sleep(RETRY_DELAY * attempt)

    log.error("   All yfinance download attempts failed.")
    return pd.DataFrame()


