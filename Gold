def run_all(jobs: list):
    """Extract all indicators sequentially."""
    results = []
    total = len(jobs)

    for idx, job in enumerate(jobs, 1):
        log.info(f"\n[{idx}/{total}] Starting {job['name']}...")
        df = extract_indicator(job)
        if not df.empty:
            save_indicator(job, df)
            results.append({
                "name":       job["name"],
                "success":    True,
                "series":     df.shape[1],
                "days":       len(df),
                "date_range": f"{df.index.min().date()} → {df.index.max().date()}",
            })
        else:
            results.append({
                "name":       job["name"],
                "success":    False,
                "series":     0,
                "days":       0,
                "date_range": "N/A",
            })

        if idx < total:
            log.info(f"   Pausing {INTER_INDICATOR_DELAY}s before next indicator...")
            time.sleep(INTER_INDICATOR_DELAY)

    print_summary(results)


def run_group(group_name: str):
    """Run a named group of indicators."""
    group_name = group_name.lower()
    if group_name not in GROUPS:
        log.error(f"Unknown group '{group_name}'. Available: {list(GROUPS.keys())}")
        return
    names = GROUPS[group_name]
    jobs = [j for j in INDICATOR_JOBS if j["name"] in names]
    log.info(f"Group '{group_name}': {len(jobs)} indicators → {names}")
    run_all(jobs)


def run_single(indicator_name: str):
    """Run a single named indicator."""
    # Check phase 1 jobs
    matches = [j for j in INDICATOR_JOBS
               if j["name"].lower() == indicator_name.lower()]
    # Also check future jobs (allow early testing)
    if not matches:
        matches = [j for j in FUTURE_INDICATOR_JOBS
                   if j["name"].lower() == indicator_name.lower()]
    if not matches:
        all_names = ([j["name"] for j in INDICATOR_JOBS] +
                     [j["name"] for j in FUTURE_INDICATOR_JOBS])
        log.error(f"Indicator '{indicator_name}' not found.")
        log.info(f"Available: {all_names}")
        return

    df = extract_indicator(matches[0])
    if not df.empty:
        save_indicator(matches[0], df)


