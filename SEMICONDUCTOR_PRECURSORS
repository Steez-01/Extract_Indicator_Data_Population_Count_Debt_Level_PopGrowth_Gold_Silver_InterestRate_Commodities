def extract_indicator(job):
    name = job["name"]
    log.info(f"\n{'='*60}\nEXTRACTING: {name}\n  {job['description']}"
             f"\n  Period: {START_DATE} -> {END_DATE}\n{'='*60}")
    all_frames = []
    for src in sorted(job["sources"], key=lambda s: s.get("priority", 99)):
        st, series, note = src["type"], src["series"], src.get("note", "")
        log.info(f"\n  Source: {st} (priority {src.get('priority','?')})")
        if note: log.info(f"    {note}")
        df = pd.DataFrame()
        if st == "fred":
            if not FRED_API_KEY:
                log.warning("    Skipping FRED — no API key. Set FRED_API_KEY env var.")
                continue
            df = fetch_fred_multiple(series, START_DATE, END_DATE)
        elif st == "yfinance":
            df = fetch_yfinance_series(series, START_DATE, END_DATE)
        if not df.empty:
            all_frames.append(df)
            log.info(f"    Got {df.shape[1]} series x {len(df)} days")
        else:
            log.warning(f"    No data from {st}")
    if not all_frames:
        log.error(f"  No data for {name}. Skipping.")
        return pd.DataFrame()
    combined = all_frames[0]
    for df in all_frames[1:]:
        new = [c for c in df.columns if c not in combined.columns]
        if new: combined = combined.join(df[new], how="outer")
    combined = combined.sort_index()
    td, ts = len(combined), combined.shape[1]
    pct = (combined.notna().sum().sum()/(td*ts)*100) if td > 0 else 0
    log.info(f"\n  COMBINED: {ts} series x {td} days")
    log.info(f"  Range: {combined.index.min().date()} -> {combined.index.max().date()}")
    log.info(f"  Completeness: {pct:.1f}%")
    for col in combined.columns:
        s = combined[col].dropna()
        if len(s) > 0:
            try: v = f"{float(s.iloc[-1]):.4f}"
            except: v = str(s.iloc[-1])
            log.info(f"    {col}: {len(s)} obs, "
                     f"{s.index.min().date()} -> {s.index.max().date()}, latest={v}")
    return combined

def save_indicator(job, df):
    if df.empty: return
    name, metadata = job["name"], job.get("metadata", {})
    df_wide = df.transpose()
    df_wide.columns = pd.to_datetime(df_wide.columns).strftime("%Y-%m-%d")
    mc = pd.DataFrame(index=df_wide.index)
    mc["Description"] = job["description"]
    mc["Unit"] = job.get("unit", "")
    mc["Frequency"] = job.get("frequency", "daily")
    for k, v in metadata.items(): mc[k] = v
    out = pd.concat([mc, df_wide], axis=1)
    fn = os.path.join(OUTPUT_DIR, f"{name}_{df.shape[1]}_series_{len(df)}_days.csv")
    out.to_csv(fn, index_label="Series")
    log.info(f"\n  SAVED: {fn}\n    {df.shape[1]} series x {len(df)} days + {len(mc.columns)} meta cols")
    save_indicator_cache(name, {"last_fetched": datetime.today().strftime("%Y-%m-%d %H:%M:%S"),
        "series_count": df.shape[1], "day_count": len(df), "file_path": fn,
        "date_range": f"{df.index.min().date()} -> {df.index.max().date()}"})

def print_summary(results):
    log.info(f"\n{'='*75}\nEXTRACTION SUMMARY\n{'='*75}")
    log.info(f"{'Indicator':<25} {'Series':>8} {'Days':>8} {'Date Range':<30} {'Status'}")
    log.info(f"{'-'*25} {'-'*8} {'-'*8} {'-'*30} {'-'*10}")
    for r in results:
        log.info(f"{r['name']:<25} {r['series']:>8} {r['days']:>8} "
                 f"{r['date_range']:<30} {'OK' if r['success'] else 'FAIL'}")
    log.info(f"\n  Total: {sum(1 for r in results if r['success'])}/{len(results)} OK")

def run_all(jobs):
    results = []
    for i, job in enumerate(jobs, 1):
        log.info(f"\n[{i}/{len(jobs)}] Starting {job['name']}...")
        df = extract_indicator(job)
        if not df.empty:
            save_indicator(job, df)
            results.append({"name": job["name"], "success": True, "series": df.shape[1],
                            "days": len(df),
                            "date_range": f"{df.index.min().date()} -> {df.index.max().date()}"})
        else:
            results.append({"name": job["name"], "success": False, "series": 0, "days": 0,
                            "date_range": "N/A"})
        if i < len(jobs): time.sleep(INTER_INDICATOR_DELAY)
    print_summary(results)

def run_group(g):
    g = g.lower()
    if g not in GROUPS:
        log.error(f"Unknown group '{g}'. Available: {list(GROUPS.keys())}"); return
    jobs = [j for j in INDICATOR_JOBS if j["name"] in GROUPS[g]]
    log.info(f"Group '{g}': {len(jobs)} indicators -> {GROUPS[g]}")
    run_all(jobs)

def run_single(name):
    m = [j for j in INDICATOR_JOBS if j["name"].lower() == name.lower()]
    if not m:
        log.error(f"'{name}' not found. Available: {[j['name'] for j in INDICATOR_JOBS]}"); return
    df = extract_indicator(m[0])
    if not df.empty: save_indicator(m[0], df)

