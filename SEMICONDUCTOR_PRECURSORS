import pandas as pd, json, os, sys, time, logging
from datetime import datetime

START_DATE = "1976-01-01"
END_DATE   = datetime.today().strftime("%Y-%m-%d")
OUTPUT_DIR = "output"
CACHE_DIR  = "indicator_cache"
RETRY_ATTEMPTS = 3
RETRY_DELAY    = 5
INTER_INDICATOR_DELAY = 3

logging.basicConfig(level=logging.INFO, format="%(asctime)s  %(levelname)s  %(message)s")
log = logging.getLogger(__name__)
os.makedirs(OUTPUT_DIR, exist_ok=True)
os.makedirs(CACHE_DIR, exist_ok=True)
FRED_API_KEY = os.environ.get("FRED_API_KEY", "")

def ensure_dependencies():
    missing = []
    for imp, pip in {"yfinance":"yfinance","pandas":"pandas","fredapi":"fredapi"}.items():
        try: __import__(imp)
        except ImportError: missing.append(pip)
    if missing:
        import subprocess
        for p in missing:
            subprocess.check_call([sys.executable,"-m","pip","install",p,"--break-system-packages","-q"])

ensure_dependencies()
import yfinance as yf
try:
    from fredapi import Fred; FRED_AVAILABLE = True
except ImportError:
    FRED_AVAILABLE = False

# --- Cache ----------------------------------------------------------------
def get_cache_path(n): return os.path.join(CACHE_DIR, f"{n}_meta.json")
def load_indicator_cache(n):
    p = get_cache_path(n)
    return json.load(open(p)) if os.path.exists(p) else {}
def save_indicator_cache(n, m):
    json.dump(m, open(get_cache_path(n),"w"), indent=2)

# --- FRED adapter ---------------------------------------------------------
def fetch_fred_series(sid, start=START_DATE, end=END_DATE, name=None):
    if not FRED_AVAILABLE or not FRED_API_KEY: return pd.Series(dtype=float)
    label = name or sid
    try:
        d = Fred(api_key=FRED_API_KEY).get_series(sid, observation_start=start, observation_end=end)
        if d is not None and not d.empty:
            d.name = label; d.index = pd.to_datetime(d.index); d = d.dropna()
            log.info(f"   FRED {sid}: {len(d)} obs ({d.index.min().date()} -> {d.index.max().date()})")
            return d
    except Exception as e: log.warning(f"   FRED {sid}: {e}")
    return pd.Series(dtype=float, name=label)

def fetch_fred_multiple(sd, start=START_DATE, end=END_DATE):
    frames = []
    for nm, sid in sd.items():
        s = fetch_fred_series(sid, start, end, name=nm)
        if not s.empty: frames.append(s)
        time.sleep(0.2)
    if frames:
        df = pd.concat(frames, axis=1); df.index = pd.to_datetime(df.index); return df.sort_index()
    return pd.DataFrame()

# --- yfinance adapter -----------------------------------------------------
def fetch_yfinance_series(tickers, start=START_DATE, end=END_DATE):
    tl = list(tickers.values()); nm = {v:k for k,v in tickers.items()}
    for attempt in range(1, RETRY_ATTEMPTS+1):
        try:
            data = yf.download(tl, start=start, end=end, auto_adjust=True, progress=False, threads=False)
            if data.empty: raise ValueError("empty")
            if isinstance(data.columns, pd.MultiIndex):
                close = data["Close"] if "Close" in data.columns.get_level_values(0) else data
            else:
                if len(tl)==1:
                    close = (data[["Close"]].rename(columns={"Close":tl[0]})
                             if "Close" in data.columns
                             else data.iloc[:,:1].set_axis([tl[0]], axis=1))
                else: close = data
            close = close.rename(columns=nm)
            log.info(f"   yfinance: {close.shape[1]} series, {len(close)} obs "
                     f"({close.index.min().date()} -> {close.index.max().date()})")
            return close
        except Exception as e:
            if "Too Many Requests" in str(e) or "Rate" in str(e): time.sleep(60*attempt)
            else:
                log.warning(f"   yfinance attempt {attempt}: {e}")
                if attempt < RETRY_ATTEMPTS: time.sleep(RETRY_DELAY*attempt)
    return pd.DataFrame()


