def run_all(jobs):
    results = []
    extracted_names = []
    for i, job in enumerate(jobs, 1):
        log.info(f"\n[{i}/{len(jobs)}] Starting {job['name']}...")
        df = extract_indicator(job)
        if not df.empty:
            save_indicator(job, df)
            extracted_names.append(job["name"])
            results.append({"name": job["name"], "success": True, "series": df.shape[1],
                            "days": len(df),
                            "date_range": f"{df.index.min().date()} -> {df.index.max().date()}"})
        else:
            results.append({"name": job["name"], "success": False, "series": 0, "days": 0,
                            "date_range": "N/A"})
        if i < len(jobs): time.sleep(INTER_INDICATOR_DELAY)
    print_summary(results)
    if extracted_names:
        merge_to_excel(extracted_names)
    return results

def run_group(g):
    g = g.lower()
    if g not in GROUPS:
        log.error(f"Unknown group '{g}'. Available: {list(GROUPS.keys())}"); return
    jobs = [j for j in INDICATOR_JOBS if j["name"] in GROUPS[g]]
    log.info(f"Group '{g}': {len(jobs)} indicators -> {GROUPS[g]}")
    run_all(jobs)

def run_single(name):
    m = [j for j in INDICATOR_JOBS if j["name"].lower() == name.lower()]
    if not m:
        log.error(f"'{name}' not found. Available: {[j['name'] for j in INDICATOR_JOBS]}"); return
    df = extract_indicator(m[0])
    if not df.empty:
        save_indicator(m[0], df)
        merge_to_excel([m[0]["name"]])

def list_indicators():
    print(f"\n{'='*75}\nAVAILABLE INDICATORS v8 — {len(INDICATOR_JOBS)} active\n{'='*75}\n")
    for j in INDICATOR_JOBS:
        src = " + ".join(s["type"] for s in j["sources"])
        ns = sum(len(s["series"]) for s in j["sources"])
        print(f"  {j['name']:<25} {j.get('group',''):<15} [{src}] ({ns} series)")
        print(f"    {j['description']}")
    print(f"\nGroups (--group):")
    for g, ns in GROUPS.items(): print(f"  {g:<15} -> {ns}")
    print(f"\nFRED: {'SET' if FRED_API_KEY else 'NOT SET'} "
          f"(free: https://fred.stlouisfed.org/docs/api/api_key.html)\n")
    print(f"Output: single Excel workbook in {OUTPUT_DIR}/\n")

