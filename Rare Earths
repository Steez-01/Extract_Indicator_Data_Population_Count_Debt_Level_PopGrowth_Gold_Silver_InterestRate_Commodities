def merge_to_excel(job_names: list = None):
    """Write all stored indicator DataFrames as tabs in one Excel workbook.

    Reads from _INDICATOR_FRAMES (populated by save_indicator during the run).
    Each tab = one indicator, named with the human-readable TAB_NAMES.
    First sheet = Summary overview.

    Args:
        job_names: list of indicator names to include. If None, uses all stored.
    """
    if not _INDICATOR_FRAMES:
        log.warning("  No indicator data in memory — nothing to merge.")
        return None

    # Determine which indicators to write
    if job_names:
        names_to_write = [n for n in job_names if n in _INDICATOR_FRAMES]
    else:
        names_to_write = list(_INDICATOR_FRAMES.keys())

    if not names_to_write:
        log.warning("  No matching indicator data found — skipping Excel.")
        return None

    log.info(f"\n{'='*60}")
    log.info(f"WRITING {len(names_to_write)} indicators to Excel workbook")
    log.info(f"{'='*60}")

    today_str = datetime.today().strftime("%Y-%m-%d")
    excel_path = os.path.join(OUTPUT_DIR,
                              f"ALL_INDICATORS_{len(names_to_write)}_tabs_{today_str}.xlsx")

    summary_rows = []

    try:
        with pd.ExcelWriter(excel_path, engine="openpyxl") as writer:
            tabs_written = 0

            for indicator_name in names_to_write:
                tab_name = TAB_NAMES.get(indicator_name, indicator_name[:31])
                df = _INDICATOR_FRAMES[indicator_name]

                if df.empty:
                    continue

                try:
                    # Count date columns vs metadata
                    date_cols = [c for c in df.columns
                                 if isinstance(c, str) and len(c) >= 4
                                 and c[:2] in ("19", "20") and "-" in c]
                    n_series = len(df)
                    n_days = len(date_cols)
                    first_date = date_cols[0] if date_cols else "N/A"
                    last_date = date_cols[-1] if date_cols else "N/A"

                    summary_rows.append({
                        "Tab": tab_name, "Indicator": indicator_name,
                        "Series": n_series, "Days": n_days,
                        "First Date": first_date, "Last Date": last_date,
                    })

                    df.to_excel(writer, sheet_name=tab_name, index=True,
                                index_label="Series", freeze_panes=(1, 1))
                    tabs_written += 1
                    log.info(f"    Tab '{tab_name}': {n_series} series x {n_days} days")

                except Exception as e:
                    log.warning(f"    {indicator_name}: failed — {e}")
                    summary_rows.append({
                        "Tab": tab_name, "Indicator": indicator_name,
                        "Series": 0, "Days": 0,
                        "First Date": "ERROR", "Last Date": str(e)[:40],
                    })

            # Write Summary tab
            if summary_rows:
                sdf = pd.DataFrame(summary_rows)
                sdf.index = range(1, len(sdf) + 1)
                sdf.index.name = "#"

                totals = pd.DataFrame([{
                    "Tab": "TOTAL",
                    "Indicator": f"{tabs_written} indicators",
                    "Series": sdf["Series"].sum(),
                    "Days": "", "First Date": "", "Last Date": "",
                }], index=[len(sdf) + 1])
                totals.index.name = "#"
                sdf = pd.concat([sdf, totals])

                sdf.to_excel(writer, sheet_name="Summary", index=True)

                wb = writer.book
                summary_sheet = wb["Summary"]
                wb.move_sheet(summary_sheet, offset=-(len(wb.sheetnames) - 1))

                for col_cells in summary_sheet.columns:
                    max_len = max((len(str(c.value or "")) for c in col_cells), default=8)
                    summary_sheet.column_dimensions[col_cells[0].column_letter].width = min(max_len + 3, 50)

        log.info(f"\n  EXCEL SAVED: {excel_path}")
        log.info(f"    {tabs_written} indicator tabs + 1 Summary tab")
        log.info(f"    Total: {sum(r['Series'] for r in summary_rows if isinstance(r['Series'], int))} series")
        return excel_path

    except Exception as e:
        log.error(f"  Excel write failed: {e}")
        return None


