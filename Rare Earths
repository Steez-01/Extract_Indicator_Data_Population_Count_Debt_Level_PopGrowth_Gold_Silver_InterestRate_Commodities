# --- FRED adapter ---------------------------------------------------------
def fetch_fred_series(sid, start=START_DATE, end=END_DATE, name=None):
    if not FRED_AVAILABLE or not FRED_API_KEY: return pd.Series(dtype=float)
    label = name or sid
    try:
        d = Fred(api_key=FRED_API_KEY).get_series(sid, observation_start=start, observation_end=end)
        if d is not None and not d.empty:
            d.name = label; d.index = pd.to_datetime(d.index); d = d.dropna()
            log.info(f"   FRED {sid}: {len(d)} obs ({d.index.min().date()} -> {d.index.max().date()})")
            return d
    except Exception as e: log.warning(f"   FRED {sid}: {e}")
    return pd.Series(dtype=float, name=label)

def fetch_fred_multiple(sd, start=START_DATE, end=END_DATE):
    frames = []
    for nm, sid in sd.items():
        s = fetch_fred_series(sid, start, end, name=nm)
        if not s.empty: frames.append(s)
        time.sleep(0.2)
    if frames:
        df = pd.concat(frames, axis=1); df.index = pd.to_datetime(df.index); return df.sort_index()
    return pd.DataFrame()

# --- yfinance adapter -----------------------------------------------------
def fetch_yfinance_series(tickers, start=START_DATE, end=END_DATE):
    tl = list(tickers.values()); nm = {v:k for k,v in tickers.items()}
    for attempt in range(1, RETRY_ATTEMPTS+1):
        try:
            data = yf.download(tl, start=start, end=end, auto_adjust=True, progress=False, threads=False)
            if data.empty: raise ValueError("empty")
            if isinstance(data.columns, pd.MultiIndex):
                close = data["Close"] if "Close" in data.columns.get_level_values(0) else data
            else:
                if len(tl)==1:
                    close = (data[["Close"]].rename(columns={"Close":tl[0]})
                             if "Close" in data.columns
                             else data.iloc[:,:1].set_axis([tl[0]], axis=1))
                else: close = data
            close = close.rename(columns=nm)
            log.info(f"   yfinance: {close.shape[1]} series, {len(close)} obs "
                     f"({close.index.min().date()} -> {close.index.max().date()})")
            return close
        except Exception as e:
            if "Too Many Requests" in str(e) or "Rate" in str(e): time.sleep(60*attempt)
            else:
                log.warning(f"   yfinance attempt {attempt}: {e}")
                if attempt < RETRY_ATTEMPTS: time.sleep(RETRY_DELAY*attempt)
    return pd.DataFrame()

# --- World Bank API adapter (NO API KEY NEEDED) ---------------------------
# Uses the free World Bank Open Data API: https://api.worldbank.org/v2/
# BATCH mode: fetches ALL countries for one indicator in a single HTTP call.
# 3 indicators × 1 call each = 3 total calls instead of 90.
#
# Series dict format: {"Display_Name": "ISO3/WB_INDICATOR_CODE"}
#   e.g. {"US_GDP_Growth": "USA/NY.GDP.MKTP.KD.ZG"}
import urllib.request, urllib.error

def fetch_worldbank_series(series_dict, start=START_DATE, end=END_DATE):
    """Fetch World Bank indicators using BATCH API calls. No API key needed.

    Groups all series by indicator code, then fetches each indicator for
    all countries in ONE call. 30 countries × 3 indicators = 3 HTTP calls.
    """
    start_year = int(start[:4])
    end_year   = int(end[:4])

    # Group series by indicator code: {indicator: [(display_name, iso3), ...]}
    indicator_groups = {}
    for display_name, spec in series_dict.items():
        parts = spec.split("/", 1)
        if len(parts) != 2:
            continue
        iso3, indicator = parts
        if indicator not in indicator_groups:
            indicator_groups[indicator] = []
        indicator_groups[indicator].append((display_name, iso3))

    frames = []

    for indicator, country_list in indicator_groups.items():
        # Build batch country string: "USA;CHN;DEU;JPN;..."
        iso3_codes = [iso3 for _, iso3 in country_list]
        countries_str = ";".join(iso3_codes)

        # Name lookup: iso3 → display_name
        name_lookup = {iso3: dname for dname, iso3 in country_list}

        url = (f"https://api.worldbank.org/v2/country/{countries_str}"
               f"/indicator/{indicator}"
               f"?format=json&per_page=10000&date={start_year}:{end_year}")

        log.info(f"   WB batch: {indicator} for {len(iso3_codes)} countries...")

        for attempt in range(1, RETRY_ATTEMPTS + 1):
            try:
                req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
                with urllib.request.urlopen(req, timeout=60) as resp:
                    raw = json.loads(resp.read())

                if not raw or len(raw) < 2 or not raw[1]:
                    log.warning(f"   WB: no data returned for {indicator}")
                    break

                # Parse response — group by country
                country_data = {}  # iso3 → {year: value}
                for rec in raw[1]:
                    iso3 = rec.get("countryiso3code") or rec.get("country", {}).get("id", "")
                    year = rec.get("date")
                    val  = rec.get("value")
                    if iso3 and year and val is not None:
                        try:
                            if iso3 not in country_data:
                                country_data[iso3] = {}
                            country_data[iso3][f"{year}-01-01"] = float(val)
                        except (ValueError, TypeError):
                            pass

                # Build a Series for each country that was requested
                for iso3, dname in name_lookup.items():
                    if iso3 in country_data and country_data[iso3]:
                        s = pd.Series(country_data[iso3], name=dname)
                        s.index = pd.to_datetime(s.index)
                        s = s.sort_index()
                        frames.append(s)

                n_got = sum(1 for iso3 in name_lookup if iso3 in country_data and country_data[iso3])
                log.info(f"   WB {indicator}: {n_got}/{len(iso3_codes)} countries, "
                         f"~{len(raw[1])} records")
                break  # success — exit retry loop

            except urllib.error.HTTPError as e:
                log.warning(f"   WB HTTP {e.code} for {indicator} (attempt {attempt}): {e.reason}")
                if attempt < RETRY_ATTEMPTS:
                    time.sleep(5 * attempt)
            except Exception as e:
                log.warning(f"   WB {indicator} attempt {attempt}: {e}")
                if attempt < RETRY_ATTEMPTS:
                    time.sleep(5 * attempt)

        time.sleep(1)  # pause between indicator batches

    if frames:
        df = pd.concat(frames, axis=1)
        df.index = pd.to_datetime(df.index)
        return df.sort_index()
    return pd.DataFrame()


# --- World Bank DEBT adapter (computes debt in USD) -----------------------
# Government debt in local currency is useless for comparison. This adapter:
#   1. Batch-fetches nominal GDP in current USD  (NY.GDP.MKTP.CD)
#   2. Batch-fetches central government debt as % of GDP (GC.DOD.TOTL.GD.ZS)
#   3. Computes: debt_USD = GDP_USD × (debt_pct / 100)
# This automatically applies the correct exchange rate for each year because
# the World Bank's GDP-in-USD series already handles currency conversion.
#
# Source type: "worldbank_debt"
# Series dict format: {"US_Debt_USD": "USA"}  (just ISO3 code)

def fetch_worldbank_debt_usd(series_dict, start=START_DATE, end=END_DATE):
    """Fetch government debt in USD for multiple countries via World Bank.

    Computes: GDP (current USD) × Debt-to-GDP ratio (%).
    No API key needed. Uses batch API calls (2 calls total).

    series_dict: {display_name: "ISO3"}  e.g. {"US_Debt_USD": "USA"}
    """
    start_year = int(start[:4])
    end_year   = int(end[:4])

    iso3_codes = list(series_dict.values())
    name_lookup = {v: k for k, v in series_dict.items()}  # ISO3 → display_name
    countries_str = ";".join(iso3_codes)

    gdp_data = {}     # iso3 → {year_str: value}
    debt_pct_data = {} # iso3 → {year_str: value}

    # Fetch 1: Nominal GDP in current USD
    gdp_indicator = "NY.GDP.MKTP.CD"
    url_gdp = (f"https://api.worldbank.org/v2/country/{countries_str}"
               f"/indicator/{gdp_indicator}"
               f"?format=json&per_page=10000&date={start_year}:{end_year}")
    log.info(f"   WB batch: GDP (current USD) for {len(iso3_codes)} countries...")
    for attempt in range(1, RETRY_ATTEMPTS + 1):
        try:
            req = urllib.request.Request(url_gdp, headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req, timeout=60) as resp:
                raw = json.loads(resp.read())
            if raw and len(raw) >= 2 and raw[1]:
                for rec in raw[1]:
                    iso3 = rec.get("countryiso3code") or rec.get("country", {}).get("id", "")
                    year = rec.get("date")
                    val  = rec.get("value")
                    if iso3 and year and val is not None:
                        try:
                            if iso3 not in gdp_data: gdp_data[iso3] = {}
                            gdp_data[iso3][year] = float(val)
                        except (ValueError, TypeError): pass
                log.info(f"   WB GDP: got data for {len(gdp_data)} countries")
            break
        except Exception as e:
            log.warning(f"   WB GDP attempt {attempt}: {e}")
            if attempt < RETRY_ATTEMPTS: time.sleep(5 * attempt)

    time.sleep(1)

    # Fetch 2: Central government debt as % of GDP
    debt_indicator = "GC.DOD.TOTL.GD.ZS"
    url_debt = (f"https://api.worldbank.org/v2/country/{countries_str}"
                f"/indicator/{debt_indicator}"
                f"?format=json&per_page=10000&date={start_year}:{end_year}")
    log.info(f"   WB batch: Debt-to-GDP (%) for {len(iso3_codes)} countries...")
    for attempt in range(1, RETRY_ATTEMPTS + 1):
        try:
            req = urllib.request.Request(url_debt, headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req, timeout=60) as resp:
                raw = json.loads(resp.read())
            if raw and len(raw) >= 2 and raw[1]:
                for rec in raw[1]:
                    iso3 = rec.get("countryiso3code") or rec.get("country", {}).get("id", "")
                    year = rec.get("date")
                    val  = rec.get("value")
                    if iso3 and year and val is not None:
                        try:
                            if iso3 not in debt_pct_data: debt_pct_data[iso3] = {}
                            debt_pct_data[iso3][year] = float(val)
                        except (ValueError, TypeError): pass
                log.info(f"   WB Debt%: got data for {len(debt_pct_data)} countries")
            break
        except Exception as e:
            log.warning(f"   WB Debt% attempt {attempt}: {e}")
            if attempt < RETRY_ATTEMPTS: time.sleep(5 * attempt)

    # Compute: debt_USD = GDP_USD × (debt_pct / 100)
    frames = []
    for iso3, display_name in name_lookup.items():
        if iso3 not in gdp_data or iso3 not in debt_pct_data:
            log.debug(f"   WB debt: missing GDP or debt% for {iso3}")
            continue

        values = {}
        for year in gdp_data[iso3]:
            if year in debt_pct_data[iso3]:
                gdp_usd = gdp_data[iso3][year]
                debt_pct = debt_pct_data[iso3][year]
                debt_usd = gdp_usd * (debt_pct / 100.0)
                values[f"{year}-01-01"] = debt_usd

        if values:
            s = pd.Series(values, name=display_name)
            s.index = pd.to_datetime(s.index)
            s = s.sort_index()
            frames.append(s)
            log.info(f"   WB debt {iso3}: {len(s)} years "
                     f"({s.index.min().year} -> {s.index.max().year}), "
                     f"latest=${s.iloc[-1]/1e9:.1f}B")

    n_got = len(frames)
    log.info(f"   WB debt: computed USD debt for {n_got}/{len(iso3_codes)} countries")

    if frames:
        df = pd.concat(frames, axis=1)
        df.index = pd.to_datetime(df.index)
        return df.sort_index()
    return pd.DataFrame()


