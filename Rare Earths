def extract_indicator(job):
    name = job["name"]
    log.info(f"\n{'='*60}\nEXTRACTING: {name}\n  {job['description']}"
             f"\n  Period: {START_DATE} -> {END_DATE}\n{'='*60}")
    all_frames = []
    for src in sorted(job["sources"], key=lambda s: s.get("priority", 99)):
        st, series, note = src["type"], src["series"], src.get("note", "")
        log.info(f"\n  Source: {st} (priority {src.get('priority','?')})")
        if note: log.info(f"    {note}")
        df = pd.DataFrame()
        if st == "fred":
            if not FRED_API_KEY:
                log.warning("    Skipping FRED — no API key. Set FRED_API_KEY env var.")
                continue
            df = fetch_fred_multiple(series, START_DATE, END_DATE)
        elif st == "yfinance":
            df = fetch_yfinance_series(series, START_DATE, END_DATE)
        elif st == "worldbank":
            df = fetch_worldbank_series(series, START_DATE, END_DATE)
        elif st == "worldbank_debt":
            df = fetch_worldbank_debt_usd(series, START_DATE, END_DATE)
        if not df.empty:
            all_frames.append(df)
            log.info(f"    Got {df.shape[1]} series x {len(df)} days")
        else:
            log.warning(f"    No data from {st}")
    if not all_frames:
        log.error(f"  No data for {name}. Skipping.")
        return pd.DataFrame()
    combined = all_frames[0]
    for df in all_frames[1:]:
        new = [c for c in df.columns if c not in combined.columns]
        if new: combined = combined.join(df[new], how="outer")
    combined = combined.sort_index()
    td, ts = len(combined), combined.shape[1]
    pct = (combined.notna().sum().sum()/(td*ts)*100) if td > 0 else 0
    log.info(f"\n  COMBINED: {ts} series x {td} days")
    log.info(f"  Range: {combined.index.min().date()} -> {combined.index.max().date()}")
    log.info(f"  Completeness: {pct:.1f}%")
    for col in combined.columns:
        s = combined[col].dropna()
        if len(s) > 0:
            try: v = f"{float(s.iloc[-1]):.4f}"
            except: v = str(s.iloc[-1])
            log.info(f"    {col}: {len(s)} obs, "
                     f"{s.index.min().date()} -> {s.index.max().date()}, latest={v}")
    return combined

def save_indicator(job, df):
    """Save indicator data as CSV with SD stats + yearly overview + daily detail.

    Output column layout:
      A    Series (index)
      B-F  Metadata: Description, Unit, Frequency, Asset Class, Region, etc.
      G    SD Basis — "Daily" or "Yearly" (indicates which raw data was used)
      H    SD Yearly
      I    SD Half-Year
      J    SD Quarterly
      K    SD Monthly
      L    SD Weekly
      M    SD Daily
      N    (blank separator)
      O    (blank separator)
      P    First year (e.g. 1976)
      Q    Next year (e.g. 1977)
      ...  one column per year through current year
      ?    (blank separator)
      ?    (blank separator)
      ?+   Daily date columns: 1976-01-02, 1976-01-05, ...

    SD calculation (returns-based):
      Computes std of PERCENTAGE RETURNS (pct_change), not raw price levels.
      This gives meaningful volatility measures:
        e.g. SPY daily SD ≈ 1.2% (daily vol), yearly SD ≈ 18% (annual vol)

      If the series has daily data with <20% gaps → "Daily" basis:
        - Daily SD   = std of daily % returns
        - Weekly SD  = std of weekly % returns (last value per week)
        - Monthly SD = std of monthly % returns
        - Quarterly  = std of quarterly % returns
        - Half-Year  = std of semi-annual % returns
        - Yearly SD  = std of annual % returns
      If the series has >=20% gaps → "Yearly" basis:
        - Yearly SD  = std of yearly % returns
        - Others     = estimated by scaling DOWN: SD_freq = SD_yearly / sqrt(periods)
    """
    if df.empty: return
    name, metadata = job["name"], job.get("metadata", {})

    # ── df has DatetimeIndex (rows=dates, cols=series names)
    df_sorted = df.sort_index()

    # ── Compute Standard Deviations of RETURNS per series ─────────────────
    sd_records = []

    for col in df_sorted.columns:
        series_data = df_sorted[col].dropna()
        n_available = len(series_data)

        record = {
            "SD_Basis":     "",
            "SD_Yearly":    "",
            "SD_HalfYear":  "",
            "SD_Quarterly": "",
            "SD_Monthly":   "",
            "SD_Weekly":    "",
            "SD_Daily":     "",
        }

        if n_available < 3:
            sd_records.append(record)
            continue

        # Determine gap ratio across the series' own date span
        span_start = series_data.index.min()
        span_end   = series_data.index.max()
        expected_bdays = len(pd.bdate_range(span_start, span_end))
        gap_ratio = 1.0 - (n_available / max(expected_bdays, 1))

        if gap_ratio < 0.20 and n_available >= 30:
            # ── DAILY BASIS: compute SD of returns at each frequency ──────
            record["SD_Basis"] = "Daily"

            # Daily returns
            daily_ret = series_data.pct_change().dropna()
            if len(daily_ret) >= 2:
                record["SD_Daily"] = round(daily_ret.std() * 100, 4)  # as %

            # Weekly returns (last value per week)
            weekly = series_data.resample("W").last().dropna()
            weekly_ret = weekly.pct_change().dropna()
            if len(weekly_ret) >= 2:
                record["SD_Weekly"] = round(weekly_ret.std() * 100, 4)

            # Monthly returns
            monthly = series_data.resample("ME").last().dropna()
            monthly_ret = monthly.pct_change().dropna()
            if len(monthly_ret) >= 2:
                record["SD_Monthly"] = round(monthly_ret.std() * 100, 4)

            # Quarterly returns
            quarterly = series_data.resample("QE").last().dropna()
            quarterly_ret = quarterly.pct_change().dropna()
            if len(quarterly_ret) >= 2:
                record["SD_Quarterly"] = round(quarterly_ret.std() * 100, 4)

            # Half-year returns
            halfyear = series_data.resample("6ME").last().dropna()
            halfyear_ret = halfyear.pct_change().dropna()
            if len(halfyear_ret) >= 2:
                record["SD_HalfYear"] = round(halfyear_ret.std() * 100, 4)

            # Yearly returns
            yearly = series_data.resample("YE").last().dropna()
            yearly_ret = yearly.pct_change().dropna()
            if len(yearly_ret) >= 2:
                record["SD_Yearly"] = round(yearly_ret.std() * 100, 4)

        else:
            # ── YEARLY BASIS: too many gaps, use annual returns + scale ────
            record["SD_Basis"] = "Yearly"

            yearly = series_data.resample("YE").last().dropna()
            yearly_ret = yearly.pct_change().dropna()
            if len(yearly_ret) >= 2:
                sd_yr = yearly_ret.std() * 100  # as %
                record["SD_Yearly"]    = round(sd_yr, 4)
                # Scale DOWN: shorter periods have smaller return SD
                # SD_freq ≈ SD_yearly / sqrt(periods_in_year)
                record["SD_HalfYear"]  = round(sd_yr / (2 ** 0.5), 4)
                record["SD_Quarterly"] = round(sd_yr / (4 ** 0.5), 4)
                record["SD_Monthly"]   = round(sd_yr / (12 ** 0.5), 4)
                record["SD_Weekly"]    = round(sd_yr / (52 ** 0.5), 4)
                record["SD_Daily"]     = round(sd_yr / (252 ** 0.5), 4)

        sd_records.append(record)

    # Build SD DataFrame (same row index as transposed data)
    sd_df = pd.DataFrame(sd_records, index=df_sorted.columns)

    # ── Build the yearly overview (first available value per year per series)
    years = sorted(df_sorted.index.year.unique())
    yearly_data = {}
    for year in years:
        year_slice = df_sorted[df_sorted.index.year == year]
        if year_slice.empty:
            continue
        first_vals = {}
        for col in year_slice.columns:
            col_data = year_slice[col].dropna()
            if not col_data.empty:
                first_vals[col] = col_data.iloc[0]
            else:
                first_vals[col] = None
        yearly_data[str(year)] = first_vals

    # ── Transpose daily data: series become rows, dates become columns
    df_wide = df_sorted.transpose()
    df_wide.columns = pd.to_datetime(df_wide.columns).strftime("%Y-%m-%d")

    # ── Build metadata columns
    mc = pd.DataFrame(index=df_wide.index)
    mc["Description"] = job["description"]
    mc["Unit"] = job.get("unit", "")
    mc["Frequency"] = job.get("frequency", "daily")
    for k, v in metadata.items():
        mc[k] = v

    # ── Build yearly overview DataFrame
    yearly_df = pd.DataFrame(yearly_data, index=df_wide.index)
    yearly_cols = sorted(yearly_df.columns, key=lambda x: int(x))
    yearly_df = yearly_df[yearly_cols]

    # ── Build separator columns (2 blank columns between sections)
    sep1 = pd.DataFrame({"  ": "", "   ": ""}, index=df_wide.index)
    sep2 = pd.DataFrame({"    ": "", "     ": ""}, index=df_wide.index)

    # ── Assemble: metadata | SD cols | sep | yearly overview | sep | daily
    out = pd.concat([mc, sd_df, sep1, yearly_df, sep2, df_wide], axis=1)

    n_meta   = len(mc.columns)
    n_sd     = len(sd_df.columns)
    n_yearly = len(yearly_df.columns)
    n_daily  = len(df_wide.columns)

    # Store in memory (merge_to_excel reads from here — no CSV files)
    _INDICATOR_FRAMES[name] = out

    log.info(f"\n  STORED: {name}")
    log.info(f"    {df.shape[1]} series x {n_daily} daily dates")
    log.info(f"    + {n_sd} SD columns (basis + 6 frequencies)")
    log.info(f"    + {n_yearly} yearly overview columns ({yearly_cols[0]}-{yearly_cols[-1]})"
             if yearly_cols else "    + 0 yearly columns")
    log.info(f"    + {n_meta} metadata cols + 4 separator cols")
    save_indicator_cache(name, {"last_fetched": datetime.today().strftime("%Y-%m-%d %H:%M:%S"),
        "series_count": df.shape[1], "day_count": len(df),
        "date_range": f"{df.index.min().date()} -> {df.index.max().date()}"})

